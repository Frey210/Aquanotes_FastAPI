#!/bin/sh
set -eu

if [ "$#" -eq 0 ]; then
  IFS= read -r requested_command
  set -- $requested_command
fi
[ "$#" -eq 2 ] && [ "$1" = "upsert" ] || exit 64
uid=$2
case "$uid" in *[!A-Za-z0-9_-]*|'') exit 64;; esac
[ "${#uid}" -ge 3 ] && [ "${#uid}" -le 36 ] || exit 64

IFS= read -r password
[ "${#password}" -ge 32 ] || exit 64
flock /run/aquanotes-mqtt-provision.lock \
  mosquitto_passwd -b /etc/mosquitto/aquanotes/passwords "$uid" "$password"
chown mosquitto:mosquitto /etc/mosquitto/aquanotes/passwords
chmod 600 /etc/mosquitto/aquanotes/passwords
systemctl reload mosquitto
printf 'ok\n'
