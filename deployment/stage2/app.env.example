DATABASE_URL=postgresql+psycopg://aquanotes_app:replace-with-password@db-host:5432/aquanotes
ADMIN_API_KEY=replace-with-random-admin-api-key
SMTP_EMAIL=replace-with-sender@gmail.com
SMTP_APP_PASSWORD=replace-with-google-app-password
FRONTEND_URL=https://aquanotes.farlabs.my.id
CORS_ORIGINS=https://aquanotes.farlabs.my.id
START_BACKGROUND_TASKS=true
LEGACY_DEVICE_TIMEZONE=Asia/Makassar
MQTT_PROVISIONING_ENABLED=true
MQTT_PROVISIONING_HOST=192.168.10.66
MQTT_PROVISIONING_PORT=22
MQTT_PROVISIONING_USER=emqxadmin
MQTT_PROVISIONING_KEY=/run/secrets/mqtt-provisioner-key
MQTT_PROVISIONING_KNOWN_HOSTS=/run/secrets/mqtt-known-hosts
